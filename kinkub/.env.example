# Browser-safe values only. Copy to .env.local (git-ignored).
# Find them in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key, database password or Google client secret
# in any VITE_ variable — Vite ships VITE_* values to the browser.

# Used only by the local Supabase CLI (supabase/config.toml), never by Vite:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# KINKUB_PRODUCTION_URL=https://your-domain.example
